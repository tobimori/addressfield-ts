{
  "name": "addressfield-ts",
  "version": "0.0.0",
  "private": true,
  "description": "Generated postal address metadata and Effect schemas.",
  "type": "module",
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "codegen": "node tools/codegen/main.ts",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/tsgo": "0.41.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "24.13.3",
    "effect": "4.0.0-rc.112",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
