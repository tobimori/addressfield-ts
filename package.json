{
  "name": "addressfield-ts",
  "version": "0.0.0",
  "description": "Generated postal address metadata and Effect schemas.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobimori/addressfield-ts.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./countries": {
      "types": "./dist/generated/countries.d.ts",
      "import": "./dist/generated/countries.js"
    },
    "./countries/*": {
      "types": "./dist/generated/countries/*.d.ts",
      "import": "./dist/generated/countries/*.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./schemas/*": {
      "types": "./dist/generated/schemas/*.d.ts",
      "import": "./dist/generated/schemas/*.js"
    },
    "./regions/*": {
      "types": "./dist/generated/regions/*.d.ts",
      "import": "./dist/generated/regions/*.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "vp pack",
    "changeset": "vp exec changeset",
    "version-packages": "vp exec changeset version",
    "release": "vp run build && vp exec changeset publish",
    "check": "vp check",
    "codegen": "node tools/codegen/main.ts",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "lint": "vp lint",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "test": "vp test",
    "typecheck": "tsc --noEmit",
    "dev": "vp pack --filter library && pnpm --filter @addressfield/playground dev"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/tsgo": "0.41.0",
    "@effect/vitest": "4.0.0-rc.112",
    "@oxlint/plugins": "1.79.0",
    "@types/node": "24.13.3",
    "effect": "4.0.0-rc.112",
    "oxlint": "1.79.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
    "vite-plus": "0.3.0",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "effect": "4.0.0-rc.112"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
